# ------------------------------------------------------------------
# Sitol Chaya — environment variables
# Copy this file to `.env.local` and fill in your Supabase values.
# ------------------------------------------------------------------

# Your Supabase project URL, e.g. https://abcdxyz.supabase.co
NEXT_PUBLIC_SUPABASE_URL=your-supabase-url

# Public anon key (safe to expose in the browser)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Service role key — SERVER ONLY. Never expose to the client.
# Used for admin tasks (e.g. seeding). Optional for basic app use.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# The public site URL, used for magic-link / email redirects.
# Local dev: http://localhost:3000  |  Netlify: https://your-site.netlify.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000
